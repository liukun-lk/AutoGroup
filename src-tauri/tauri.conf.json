{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autogroup",
  "version": "0.1.3",
  "identifier": "com.lb.autogroup",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "autogroup",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RUIzREQxMzA3OUM5MzQKUldRMHlYa3cwVDNyMkYrdDVRSjc3NlZTRHl6Q0JZUldZWlFWTHhreHNqSnhYTVRJOTd2d29oY0sK",
      "endpoints": [
        "https://github.com/liukun-lk/AutoGroup/releases/latest/download/latest.json"
      ]
    }
  }
}